    "Face Finder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder"
          }
        }
      }
    },
    "Face Finder chạy hoàn toàn trên máy. App được macOS chạy trong sandbox không có quyền truy cập mạng, và chỉ đọc/ghi được những thư mục bạn tự chọn hoặc kéo thả vào.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder runs entirely on this Mac. macOS runs the app in a sandbox with no network access, and it can only read and write folders you choose or drag in yourself."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder chạy hoàn toàn trên máy. App được macOS chạy trong sandbox không có quyền truy cập mạng, và chỉ đọc/ghi được những thư mục bạn tự chọn hoặc kéo thả vào."
          }
        }
      }
    },
    "Face Finder lưu kết quả vào thư mục này (thư mục con “%@”). Bấm “Cho phép” để đồng ý.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder saves results to this folder (in the “%@” subfolder). Click “Allow” to confirm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder lưu kết quả vào thư mục này (thư mục con “%@”). Bấm “Cho phép” để đồng ý."
          }
        }
      }
    },
    "Face Finder lập chỉ mục khuôn mặt một lần, sau đó tìm ảnh của bất kỳ ai chỉ trong vài giây.\nMọi thứ chạy trên máy này; app không có quyền truy cập mạng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder indexes faces once, then finds photos of anyone in just seconds.\nEverything runs on this Mac; the app has no network access."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Face Finder lập chỉ mục khuôn mặt một lần, sau đó tìm ảnh của bất kỳ ai chỉ trong vài giây.\nMọi thứ chạy trên máy này; app không có quyền truy cập mạng."
          }
        }
      }
    },
