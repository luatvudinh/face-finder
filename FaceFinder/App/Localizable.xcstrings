    "Chỉ mục và khuôn mặt mẫu chỉ nằm trên máy này, trong thư mục riêng của app. Thư mục kết quả đã ghi ra không bị ảnh hưởng.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The index and reference faces stay only on this Mac, in the app’s private folder. Results folders already written aren’t affected."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ mục và khuôn mặt mẫu chỉ nằm trên máy này, trong thư mục riêng của app. Thư mục kết quả đã ghi ra không bị ảnh hưởng."
          }
        }
      }
    },
    "Chỉ nhận thư mục hoặc file zip": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only folders or zip files are accepted"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhận thư mục hoặc file zip"
