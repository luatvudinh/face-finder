    },
    "%lld ảnh mẫu. App đề xuất người #1; bấm vào hàng khác nếu chọn sai.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reference photo. The app suggests person #1; click another row if that’s the wrong person."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reference photos. The app suggests person #1; click another row if that’s the wrong person."
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ảnh mẫu. App đề xuất người #1; bấm vào hàng khác nếu chọn sai."
          }
        }
      }
    },
    "%lld ảnh mẫu. Đã chọn sẵn người #1. Nên thêm ảnh (ít nhất 3) để tìm chính xác hơn.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reference photo. Person #1 is already selected. Add more photos (at least 3) for more accurate results."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld reference photos. Person #1 is already selected. Add more photos (at least 3) for more accurate results."
                }
              }
            }
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ảnh mẫu. Đã chọn sẵn người #1. Nên thêm ảnh (ít nhất 3) để tìm chính xác hơn."
          }
        }
      }
    },
    "<tên>": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "<name>"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "<tên>"
          }
        }
      }
    },
    "Bấm chọn ảnh (Cmd hoặc Shift để chọn nhiều) rồi nhấn D (đúng) hoặc S (sai) để dạy thêm cho app, Space để xem ảnh lớn, phím mũi tên để chuyển ảnh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select photos (hold Command or Shift to select several), then press Y (yes) or N (no) to teach the app, Space to see a photo larger, or the arrow keys to move between photos."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bấm chọn ảnh (Cmd hoặc Shift để chọn nhiều) rồi nhấn D (đúng) hoặc S (sai) để dạy thêm cho app, Space để xem ảnh lớn, phím mũi tên để chuyển ảnh."
          }
        }
      }
    },
