    "%lld ảnh không ghi được (vd. %@). Các ảnh khác đã được cập nhật.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save %1$lld photos (e.g. %2$@). The others were updated."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld ảnh không ghi được (vd. %2$@). Các ảnh khác đã được cập nhật."
          }
        }
      }
    },
